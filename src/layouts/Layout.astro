---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Noticias de inteligencia artificial en español, generadas y curadas de forma automatizada.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16171b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <slot />
  </body>
</html>
