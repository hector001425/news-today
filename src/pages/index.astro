---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf()
);

const categoryLabels: Record<string, string> = {
  modelos: 'Modelos',
  negocios: 'Negocios',
  investigacion: 'Investigación',
  politica: 'Política y regulación',
  producto: 'Producto',
  tecnologia: 'Tecnología',
};

const formatter = new Intl.DateTimeFormat('es', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });

const tickerItems = allArticles.slice(0, 8);
---
<Layout title="News Today — Noticias de inteligencia artificial en español">
  <div class="ticker" role="marquee" aria-label="Últimos titulares">
    <div class="ticker__track">
      {tickerItems.map((a) => (
        <span class="ticker__item">{a.data.title}</span>
      ))}
      {tickerItems.map((a) => (
        <span class="ticker__item" aria-hidden="true">{a.data.title}</span>
      ))}
    </div>
  </div>

  <header class="masthead">
    <div class="masthead__row">
      <h1 class="masthead__title">News <span>Today</span></h1>
      <div class="masthead__meta-group">
        <button type="button" id="install-btn" class="install-btn" hidden aria-label="Instalar app" title="Instalar app">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 19h14" />
          </svg>
        </button>
        <div class="masthead__meta">
          Actualizado automáticamente<br />
          {formatter.format(new Date())}
        </div>
      </div>
    </div>
    <p class="masthead__dek">
      Lo último en inteligencia artificial — modelos, negocios, investigación y regulación — resumido en español, todos los días.
    </p>
  </header>

  <main class="feed">
    {allArticles.length === 0 && (
      <p style="padding: 2rem; font-family: var(--font-mono); color: var(--ink-soft);">
        Todavía no hay artículos. Agregá archivos .md en src/content/articles/ o conectá el pipeline de n8n descrito en /n8n.
      </p>
    )}
    {allArticles.map((article) => (
      <article class="card">
        <div class="card__eyebrow">
          {article.data.breaking && <span class="card__flash">Última hora</span>}
          <span>{categoryLabels[article.data.category]}</span>
          <time datetime={article.data.published_at.toISOString()}>
            {formatter.format(article.data.published_at)}
          </time>
        </div>
        <h2 class="card__title">
          <a href={`/articulos/${article.id}/`}>{article.data.title}</a>
        </h2>
        <p class="card__dek">{article.data.dek}</p>
        <p class="card__source">Fuente: {article.data.source_name}</p>
      </article>
    ))}
  </main>

  <footer class="site-footer">
    <span>News Today — proyecto personal, contenido generado con apoyo de IA a partir de fuentes públicas</span>
    <span>news-today.app</span>
  </footer>

  <script type="module" src="/install-pwa.js" defer></script>
</Layout>
