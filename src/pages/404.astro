---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada — News Today">
  <header class="masthead">
    <div class="masthead__row">
      <a href="/" style="font-family: var(--font-mono); font-size: 0.8rem;">&larr; News Today</a>
    </div>
  </header>
  <main style="max-width: 720px; margin: 0 auto; padding: 4rem 1.5rem; text-align: center;">
    <h1 style="font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 2.6rem); margin-bottom: 0.8rem;">
      404 — Página no encontrada
    </h1>
    <p style="font-size: 1.05rem; color: var(--ink-soft);">
      El artículo o la página que buscás no existe o fue movida.
    </p>
    <p style="margin-top: 1.5rem;">
      <a href="/">Volver a la portada</a>
    </p>
  </main>
</Layout>
